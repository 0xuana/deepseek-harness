{
  "name": "@deepseek-ai/dsh-experimental-liveshare-protocol",
  "description": "Liveshare wire frames and the identity contract shared by the owner bundle and the Relay",
  "version": "0.2.1-rc.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/liveshare-protocol"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./identity": {
      "types": "./lib/types/identity/index.d.ts",
      "default": "./lib/identity/index.js"
    },
    "./identity/mock": {
      "types": "./lib/types/identity/mock.d.ts",
      "default": "./lib/identity/mock.js"
    },
    "./protocol": {
      "types": "./lib/types/tunnel-protocol.d.ts",
      "default": "./lib/tunnel-protocol.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/identity/index.js",
    "lib/identity/mock.js",
    "lib/tunnel-protocol.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-brand": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "publishConfig": {
    "access": "public"
  }
}
