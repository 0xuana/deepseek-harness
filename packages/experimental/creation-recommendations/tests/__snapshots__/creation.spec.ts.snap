exports[`interface creation > discovers shipped plugins without the recommendation or management tools and withdraws discovery on unload > one selected need without invented requirements 1`] = `
{
  "discovery": "Read shipped DSH plugins and their enabled state to check existing capabilities before proposing a new interface. Select one need first: follow explicit priority; otherwise prefer a suitable existing plugin. If list_official_plugins already found a plugin for that need, use it without querying this catalog to plan another, unselected need. Do not query after offering a card or for vague, quoted or discussion-only requests that decline recommendations. Clarify missing requirements before discovery. An absent entry does not prove that DSH lacks a built-in feature. Keep discovery at product level; do not inspect source, private profiles or implementation docs just to propose a feature.",
  "parameters": {
    "properties": {
      "brief": {
        "description": "Concise plan for only the selected need: behavior, known data sources, relevant context and completion criteria, in the user’s language. Do not infer its purpose from another independent wish. Clarify missing requirements before calling. Shown on the card and passed to the Creator.",
        "type": "string",
      },
      "slot": {
        "description": "Apply this order: (1) Honor a location explicitly requested by the user. (2) A global feature uses sidebar-left: one left entry opens a standalone main-area page without Chat/Trajectory tabs, including global streaming tools. (3) A Session-bound streaming dialogue or interactive assistant uses page: a tab beside Chat and Trajectory; Session scope is not a reason to put streaming dialogue in the right sidebar. (4) Other Session-bound viewers, editors and Context inspection use sidebar-right. Do not invent a right-sidebar preference to replace the streaming-tab rule. If scope or interaction is unclear, clarify first.",
        "enum": [
          "sidebar-right",
          "page",
          "sidebar-left",
        ],
        "type": "string",
      },
      "title": {
        "description": "Short name in the user’s language.",
        "type": "string",
      },
    },
    "required": [
      "title",
      "brief",
      "slot",
    ],
    "type": "object",
  },
  "proposal": "Propose a new persistent interface for one explicit need, including everyday wishes. Select ONE recommendation per turn across suggest_view and suggest_plugin before calling either, even if multiple cards are requested; never batch recommendations. Honor explicit priority; otherwise prefer a suitable existing plugin. Discuss other independent needs in the answer, without merging them or promising an automatic later card. Clarify an unknown purpose, data source or interaction before proposing; do not guess these from an unrelated need. Read list_creation_plugins for the selected creation need first. Use an existing capability when suitable, or suggest_plugin if available for an eligible disabled plugin; otherwise explain its Plugins entry, without creating a duplicate. No cards for vague wishes, ordinary tasks, quoted requests or discussion-only requests that decline recommendations. Keep the brief concise and at product level: requested behavior, known data sources, relevant context, completion criteria and location. Defer source/API inspection to the Creator. Call before the final answer, then answer concisely in the user’s language using only successful results; a rejected call created no card. The card appears below the completed answer. Do not create or install anything: the user must click Create, which starts a Creator to build a new removable plugin. Existing plugins are never edited.",
}
`;

exports[`interface creation > reserves one recommendation before parallel tools settle, including the official recommendation tool > rejected extra proposal does not promise a card 1`] = `
